	quest.2BCF50E758E1E188.title: "Grade 1"
	quest.312D16EEC20ED5E3.title: "Frostmaw"
	quest.35E9AA90A7C2DBFB.title: "The Wither"
	quest.369A3C9A91C53DA1.title: "Elder Guardian"
	quest.37F4B01F78D2D9BC.quest_desc: ["Your technique and grade are shown above your hotbar.", "", "Abilities cost &dcursed energy&r, which refills over about 30 seconds. Watch the cooldowns."]
	quest.37F4B01F78D2D9BC.quest_subtitle: "Find out what you were born with"
	quest.37F4B01F78D2D9BC.title: "Your Innate Technique"
	quest.38016D13B9E71AC1.quest_desc: ["The peak. Unlocks your &cMaximum&r technique (G) and &aReverse Cursed Technique&r, which slowly heals you with cursed energy."]
	quest.38016D13B9E71AC1.quest_subtitle: "30,000 XP, 12 Black Flashes, 2 bosses"
	quest.38016D13B9E71AC1.title: "Special Grade"
	quest.40757890E61DE6BF.quest_desc: ["Big multiblock machines. Craft the Engineer's Hammer and read the manual."]
	quest.40757890E61DE6BF.title: "Immersive Engineering"
	quest.47273348BBAD08A0.title: "Maledictus"
	quest.4893E864CB61A69D.title: "Ender Dragon"
