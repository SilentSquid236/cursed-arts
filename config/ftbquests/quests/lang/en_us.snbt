	file.0000000000000001.title: "Cursed Arts"
	quest.012E7235E82B6BC3.quest_desc: ["A domain raises a barrier around you and everything inside suffers your technique's sure-hit effect.", "", "If two domains overlap they &6clash&r: the stronger one shatters the other. Afterwards your technique &cburns out&r for 10 seconds, so pick your moment."]
	quest.012E7235E82B6BC3.quest_subtitle: "Trap them in your world"
	quest.012E7235E82B6BC3.title: "Domain Expansion"
	quest.098B9B4D404C2C4C.quest_desc: ["New terrain, biomes and structures everywhere: Terralith and Tectonic reshape the land, YUNG's mods rebuild every structure, and dungeons hide loot.", "", "Loot chests are per-player (Lootr), so everyone gets their own."]
	quest.098B9B4D404C2C4C.title: "Expedition"
	quest.10CA6AEFCA685500.quest_desc: ["From kinetic contraptions to fusion reactors. Each row is a different tech mod; JEI (press &eR&r on an item) shows every recipe."]
	quest.10CA6AEFCA685500.title: "Modern Engineering"
	quest.1366816401288A7D.quest_desc: ["Fancy automation and machines with visible moving parts."]
	quest.1366816401288A7D.title: "Oritech"
	quest.1FCE7F9A9B85BB1B.quest_desc: ["Design your own spells from glyphs. Start by crafting the Novice Spell Book."]
	quest.1FCE7F9A9B85BB1B.title: "Ars Nouveau"
	quest.26CBBBC2B9C2AE94.title: "Into the Nether"
	quest.2BCF50E758E1E188.quest_desc: ["Promotion to Grade 1 unlocks &dDomain Expansion&r (V)."]
